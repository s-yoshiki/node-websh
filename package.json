{
  "name": "node-websh",
  "version": "0.2.0",
  "private": true,
  "description": "Browser terminal powered by xterm.js, Hono and node-pty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-yoshiki/node-websh.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "check:fix": "pnpm lint:fix && pnpm format",
    "verify": "pnpm check && pnpm test && pnpm build",
    "postinstall": "node scripts/postinstall.mjs",
    "build:sea": "pnpm build && node apps/server/scripts/build-sea.mjs",
    "start": "node apps/server/dist/main.js",
    "test:e2e": "node scripts/smoke-test.mjs",
    "test:e2e:sea": "node scripts/smoke-test.mjs --sea",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postject": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.20.0"
}
