{
  "name": "@node-websh/server",
  "version": "0.2.0",
  "private": true,
  "description": "Hono server exposing a PTY over WebSocket, with the built frontend served alongside",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts --allowed-origin http://localhost:5173",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/node-ws": "catalog:",
    "@node-websh/protocol": "workspace:*",
    "hono": "catalog:",
    "node-pty": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@node-websh/tsconfig": "workspace:*",
    "@node-websh/web": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
